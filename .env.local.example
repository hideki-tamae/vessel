## RPC (専用エンドポイント)
#
# 目的: 共有RPC（例: eth.merkle.io 等）による 429 を避けるため、
# wagmi/viem の通信を専用RPCへ切替します。
#
# 使い方:
# 1) このファイルをコピーして `.env.local` を作成
# 2) どれか1つのURL（Alchemy か Infura）を入れて `NEXT_PUBLIC_RPC_URL` に設定
#
# 例:
# NEXT_PUBLIC_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>"
# NEXT_PUBLIC_RPC_URL="https://mainnet.infura.io/v3/<INFURA_API_KEY>"
#

# 必須（フロントで参照されます）
NEXT_PUBLIC_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>"

# (任意) 参考: Infura を使う場合は上の値を差し替え
# NEXT_PUBLIC_RPC_URL="https://mainnet.infura.io/v3/<INFURA_API_KEY>"

## Python backend (ローカル同居)
# Next.js の /api/bridge/* がここへプロキシします。
CIV_OS_BACKEND_URL="http://127.0.0.1:8000"

# (任意) Next.js が別ポート/別ホストの時に上書き
# CIV_OS_BACKEND_URL="http://localhost:8000"

# (任意) Next -> Bridge のURLを強制する場合（通常は不要）
# CREWAI_BRIDGE_URL="http://127.0.0.1:3000/api/bridge/analyze"

## Firebase (src/lib/firebase.ts / /dashboard で使用)
#
# 目的: Firestoreを使った Dashboard コンポーネントのデータ購読に必要です。
# NEXT_PUBLIC_* はビルド時にクライアントバンドルへ埋め込まれるため、
# Docker ビルド時は --build-arg でも同名の値を渡してください（Dockerfile 参照）。
#
# 取得場所: Firebase コンソール > プロジェクトの設定 > 全般 > マイアプリ > SDK の設定と構成
NEXT_PUBLIC_FIREBASE_API_KEY="<FIREBASE_WEB_API_KEY>"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="<PROJECT_ID>.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="<PROJECT_ID>"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="<PROJECT_ID>.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="<MESSAGING_SENDER_ID>"
NEXT_PUBLIC_FIREBASE_APP_ID="<APP_ID>"

